# Copier ce fichier en .env.development puis adapter les valeurs :
#   cp .env.example .env.development

NODE_ENV=development
PORT=3000

# Nom du service MySQL dans docker-compose.dev.yaml
MYSQL_HOST=mysql
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=secretsDeHammam_dev

# Nom du service MongoDB dans docker-compose.dev.yaml
MONGODB_HOST=mongodb
MONGODB_USER=root
MONGODB_PASSWORD=change-me
MONGODB_DATABASE=secretDeHammam_dev

# URL de l'API (préfixe VITE_ obligatoire pour être lue par Vite)
VITE_API_URL=http://127.0.0.1:3000

# Origines autorisées par CORS (séparées par des virgules)
ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Dossier des fichiers publics (images produits)
PUBLIC_DIR=public

# Clé de signature des JWT : chaîne longue et aléatoire (256 caractères recommandés)
VITE_JWT_SECRET=change-me
